{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
    "scripts": {
      "dev": "vite",
      "server": "cd main-site/backend && node server.js",
      "start": "concurrently \"npm run server\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"cyan,green\"",
      "clean": "if exist dist (rd /s /q dist)",
      "build": "vite build",
      "build:main": "cd main-site && npm run build",
      "copy:main": "xcopy /E /I /Y main-site\\dist dist",
      "copy:404": "copy 404.html dist\\404.html /Y",
      "build:all": "npm run clean && npm run build && npm run build:main && npm run copy:main && npm run copy:404",
      "lint": "eslint .",
      "preview": "vite preview",
      "deploy": "echo ERROR: Please deploy from the main vite-project folder using 'npm run deploy' there. Do not deploy from this folder!"
    },

  
  "dependencies": {
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.8",
    "vite": "^6.3.5"
  },
  
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
